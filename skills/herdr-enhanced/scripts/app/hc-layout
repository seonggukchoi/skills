#!/usr/bin/env python3
"""Entry point for hc-layout; the code lives in the hc_layout package beside this file.

Usage is in `hc-layout --help` and in references/app/layout.md.
"""

import os
import sys

# Resolve symlinks so the package is found wherever the skill was installed, and keep
# the skill directory free of __pycache__.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
sys.dont_write_bytecode = True

from hc_layout.cli import main  # noqa: E402

if __name__ == "__main__":
    main()
